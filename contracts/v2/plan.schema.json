{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideaflow.local/contracts/v2/plan.schema.json",
  "title": "任务计划（目标态，向后兼容当前任务清单）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "version",
    "spec_ref",
    "tasks",
    "status",
    "created_at"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^PLAN-[A-Za-z0-9_-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "spec_ref": {
      "type": ["object", "null"],
      "description": "由规格生成的计划引用对应的规格版本；直接从任务清单启动时为 null",
      "additionalProperties": false,
      "required": [
        "spec_id",
        "version",
        "hash"
      ],
      "properties": {
        "spec_id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "hash": {
          "$ref": "enums.schema.json#/$defs/hash"
        }
      }
    },
    "max_parallel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "name",
          "deliverable",
          "acceptance_items",
          "suggested_role",
          "priority"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^T-?\\d+[A-Za-z]?$",
            "description": "任务号；测试任务用 T{n}T、评审任务用 T{n}R 后缀"
          },
          "name": {
            "type": "string"
          },
          "deliverable": {
            "type": "string"
          },
          "acceptance_items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggested_role": {
            "$ref": "enums.schema.json#/$defs/role"
          },
          "priority": {
            "$ref": "enums.schema.json#/$defs/priority"
          },
          "requirement_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "design_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "estimate_days": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 10
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "write_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "review_required": {
            "type": "boolean"
          },
          "kind": {
            "$ref": "enums.schema.json#/$defs/taskKind",
            "description": "任务类型；缺省按 code 处理。计划生成时自动追加 test / review 任务"
          }
        }
      }
    },
    "status": {
      "$ref": "enums.schema.json#/$defs/planStatus"
    },
    "created_at": {
      "$ref": "enums.schema.json#/$defs/timestamp"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "$ref": "enums.schema.json#/$defs/timestamp"
    },
    "hash": {
      "$ref": "enums.schema.json#/$defs/hash"
    }
  }
}
