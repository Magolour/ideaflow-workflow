{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideaflow.local/contracts/v2/features.schema.json",
  "title": "需求归纳：功能清单",
  "description": "讨论收敛后，把主张与方案范围归纳成可落模块的功能清单。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_ref",
    "features",
    "created_at"
  ],
  "properties": {
    "snapshot_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "version"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "source_refs",
          "inferred",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-\\d+$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 24,
            "description": "功能名，写成动作或能力，不写过程约束"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "description": "来源：主张编号、方案编号或需求编号，至少一条",
            "items": {
              "type": "string"
            }
          },
          "inferred": {
            "type": "boolean",
            "description": "true 表示由讨论推断、尚未经用户确认"
          },
          "priority": {
            "$ref": "enums.schema.json#/$defs/priority"
          }
        }
      }
    },
    "created_at": {
      "$ref": "enums.schema.json#/$defs/timestamp"
    }
  }
}
