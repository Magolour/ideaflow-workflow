{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideaflow.local/contracts/v2/delivery.schema.json",
  "title": "交付记录",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "delivery_id",
    "instance_id",
    "items",
    "status",
    "created_at"
  ],
  "properties": {
    "delivery_id": {
      "type": "string",
      "pattern": "^DLV-[A-Za-z0-9_-]+$"
    },
    "instance_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^PLAN-[A-Za-z0-9_-]+$",
      "description": "从计划入口启动时带计划号；任务清单入口（夹具）无计划号，可省略"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "artifact_ids",
          "acceptance"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^ART-[A-Za-z0-9_-]+$"
            }
          },
          "acceptance": {
            "$ref": "enums.schema.json#/$defs/acceptanceResult"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "$ref": "enums.schema.json#/$defs/deliveryStatus"
    },
    "decided_by": {
      "type": "string"
    },
    "decided_at": {
      "$ref": "enums.schema.json#/$defs/timestamp"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^DEC-[A-Za-z0-9_-]+$"
    },
    "created_at": {
      "$ref": "enums.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "confirmed",
              "rejected"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "decided_by",
          "decided_at"
        ]
      }
    }
  ]
}
