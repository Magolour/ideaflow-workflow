{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideaflow.local/contracts/v2/idea.schema.json",
  "title": "原始想法",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idea_id",
    "version",
    "raw_text",
    "constraints",
    "status",
    "created_by",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "enums.schema.json#/$defs/schemaVersion"
    },
    "idea_id": {
      "type": "string",
      "pattern": "^IDEA-[A-Za-z0-9_-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "raw_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed"
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "enums.schema.json#/$defs/timestamp"
    }
  }
}
