{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideaflow.local/contracts/v2/snapshot.schema.json",
  "title": "需求快照（需求规格）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "version",
    "status",
    "hash",
    "created_at",
    "parent_version",
    "retired_ids",
    "counts",
    "source",
    "items",
    "history"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^REQSET-[A-Za-z0-9_-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "$ref": "enums.schema.json#/$defs/snapshotStatus"
    },
    "hash": {
      "$ref": "enums.schema.json#/$defs/hash"
    },
    "created_at": {
      "$ref": "enums.schema.json#/$defs/timestamp"
    },
    "parent_version": {
      "type": [
        "integer",
        "null"
      ]
    },
    "confirmed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "confirmed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "retired_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement",
        "constraint",
        "open"
      ],
      "properties": {
        "requirement": {
          "type": "integer"
        },
        "constraint": {
          "type": "integer"
        },
        "open": {
          "type": "integer"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_text",
        "char_count"
      ],
      "properties": {
        "raw_text": {
          "type": "string"
        },
        "char_count": {
          "type": "integer"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "text",
          "priority",
          "acceptance",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[RCQ]-?\\d+$"
          },
          "type": {
            "$ref": "enums.schema.json#/$defs/requirementType"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "$ref": "enums.schema.json#/$defs/snapshotPriority"
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "start_line",
              "end_line",
              "excerpt"
            ],
            "properties": {
              "section": {
                "type": "string"
              },
              "start_line": {
                "type": "integer"
              },
              "end_line": {
                "type": "integer"
              },
              "excerpt": {
                "type": "string"
              },
              "actor": {
                "type": "string",
                "description": "提出者（讨论角色）；原文条目可省略"
              },
              "round": {
                "type": "integer",
                "minimum": 0,
                "description": "讨论轮次；原文条目可省略"
              }
            }
          },
          "label": {
            "type": "string"
          },
          "priority_label": {
            "type": "string"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "hash",
          "reason",
          "actor",
          "at"
        ],
        "properties": {
          "version": {
            "type": "integer"
          },
          "hash": {
            "$ref": "enums.schema.json#/$defs/hash"
          },
          "reason": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "at": {
            "$ref": "enums.schema.json#/$defs/timestamp"
          }
        }
      }
    }
  }
}
