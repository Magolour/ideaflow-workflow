{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ideaflow.local/contracts/v2/artifact.schema.json",
  "title": "任务产物",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "task_id",
    "kind",
    "created_at"
  ],
  "properties": {
    "artifact_id": {
      "type": "string",
      "pattern": "^ART-[A-Za-z0-9_-]+$"
    },
    "task_id": {
      "type": "string"
    },
    "kind": {
      "$ref": "enums.schema.json#/$defs/artifactKind"
    },
    "path": {
      "type": "string"
    },
    "hash": {
      "$ref": "enums.schema.json#/$defs/hash"
    },
    "summary": {
      "type": "string"
    },
    "created_at": {
      "$ref": "enums.schema.json#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "file"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "path"
        ]
      }
    }
  ]
}
